# VigilantEye backend — optional local (non-Docker API) mode
# Canonical setting is DATABASE_URL. Legacy DATABASE_* vars are fallback only.

APP_ENV=development
# ENABLE_API_DOCS=1
# ENABLE_DEMO_SEED=1

# Point at Compose Postgres on the host-mapped port (recommended local hybrid):
DATABASE_URL=postgresql+psycopg://vigilant:CHANGE_ME_LOCAL_ONLY@127.0.0.1:15432/vigilant_eye

JWT_SECRET=CHANGE_ME_LOCAL_ONLY_USE_LONG_RANDOM
# Prefer 60 for production; demo may override higher.
JWT_EXPIRE_MINUTES=60

# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Legacy fallback (used only if DATABASE_URL is unset):
# DATABASE_HOST=127.0.0.1
# DATABASE_PORT=15432
# DATABASE_NAME=vigilant_eye
# DATABASE_USER=vigilant
# DATABASE_PASSWORD=CHANGE_ME_LOCAL_ONLY

# Optional SMTP (otherwise EMAIL_MOCK). Never commit real passwords.
# EMAIL_ENABLED=1
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=
# SMTP_FROM_EMAIL=
# SMTP_FROM_NAME=VigilantEye
# SMTP_USE_TLS=true
# SMTP_TIMEOUT_SECONDS=15
# PORTAL_BASE_URL=http://127.0.0.1:5173

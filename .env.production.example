# VigilantEye — PRODUCTION environment template
# Copy to ".env.production" (never commit real secrets).
#
# Start:
#   docker compose --env-file .env.production -f docker-compose.prod.yml up --build -d
#
# Do NOT reuse development .env values (CHANGE_ME_*, long JWT TTL, empty CORS).

# --- Runtime ---
APP_ENV=production
ENABLE_API_DOCS=0
ENABLE_DEMO_SEED=0
PASSWORD_LOGIN_ENABLED=0
AUTH_MODE=google

# --- Google Sign-In (required) ---
# OAuth Web client ID from Google Cloud Console (NOT JWT_SECRET).
GOOGLE_CLIENT_ID=
# Optional — unused by GIS ID-token verification:
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# --- PostgreSQL ---
POSTGRES_DB=vigilant_eye
POSTGRES_USER=vigilant
POSTGRES_PASSWORD=
POSTGRES_HOST_PORT=15432

# --- API ---
JWT_SECRET=
JWT_EXPIRE_MINUTES=60
CORS_ORIGINS=
API_HOST_PORT=8000
LIVE_POSTURE=1

# --- Email notifications ---
# Set EMAIL_ENABLED=0 to boot without SMTP.
# If EMAIL_ENABLED=1 (default here), production validation requires SMTP_HOST + SMTP_FROM.
# Google OAuth credentials are NOT SMTP credentials. Prefer a dedicated notifications mailbox.
# Gmail/Google Workspace may require an App Password or approved SMTP relay.
EMAIL_ENABLED=1
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=VigilantEye
SMTP_USE_TLS=true
SMTP_TIMEOUT_SECONDS=15
# Public portal URL used in email links (no tokens):
PORTAL_BASE_URL=

# --- Frontend (baked into nginx image at build time) ---
# Never put SMTP_* into frontend build args.
VITE_API_URL=
FRONTEND_HOST_PORT=8080

# VigilantEye — root Compose / demo environment (development only)
# Copy to ".env" (never commit .env). start-dev.ps1 can create it from this file.
#
# Production: use .env.production.example → .env.production with
#   docker compose --env-file .env.production -f docker-compose.prod.yml up --build -d

# --- Runtime mode ---
# development (default) | production
APP_ENV=development
# AUTH_MODE: demo (default) | google | both
#   demo   = password + viva shortcuts (Google hidden)
#   google = Continue with Google only (set GOOGLE_CLIENT_ID)
#   both   = Google + password/demo (development only; forbidden in production)
# AUTH_MODE=demo
# ENABLE_API_DOCS=1
# ENABLE_DEMO_SEED=1
# PASSWORD_LOGIN_ENABLED=1

# --- Google Sign-In (required when AUTH_MODE=google or both) ---
# GOOGLE_CLIENT_ID=1234567890-xxxx.apps.googleusercontent.com
# Do NOT confuse with JWT_SECRET. Client secret is not used for GIS ID tokens.
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=

# --- Email notifications (optional; MOCK when SMTP unset) ---
# Google auth ≠ SMTP. Do not use GOOGLE_CLIENT_ID / client secret as SMTP password.
# Gmail/Workspace typically needs an App Password or approved SMTP relay.
# EMAIL_ENABLED=1
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=
# SMTP_FROM_EMAIL=
# SMTP_FROM_NAME=VigilantEye
# SMTP_USE_TLS=true
# SMTP_TIMEOUT_SECONDS=15
# PORTAL_BASE_URL=http://127.0.0.1:5173

# --- PostgreSQL (Compose service "db") ---
POSTGRES_DB=vigilant_eye
POSTGRES_USER=vigilant
POSTGRES_PASSWORD=CHANGE_ME_LOCAL_ONLY
# Host port mapped to container 5432 (avoids Windows PG on 5432/5433)
POSTGRES_HOST_PORT=15432

# --- API (Compose builds DATABASE_URL for the container automatically) ---
JWT_SECRET=CHANGE_ME_LOCAL_ONLY_USE_LONG_RANDOM
# Prefer 60 for production. Demo sessions may use a longer value (e.g. 480).
JWT_EXPIRE_MINUTES=60
LIVE_POSTURE=1

# Comma-separated browser origins. Leave empty for localhost Vite defaults.
# Production example: CORS_ORIGINS=https://ufm.example.edu
# CORS_ORIGINS=

# --- Frontend (browser → host API) ---
VITE_API_URL=http://127.0.0.1:8000

# Optional: if you run the API on the host against Compose Postgres only:
# DATABASE_URL=postgresql+psycopg://vigilant:CHANGE_ME_LOCAL_ONLY@127.0.0.1:15432/vigilant_eye
